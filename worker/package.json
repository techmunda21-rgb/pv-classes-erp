{
  "name": "pv-erp-api",
  "version": "1.0.0",
  "private": true,
  "description": "PV Classes ERP — Cloudflare Workers API",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "build": "tsc --noEmit && echo 'Type check passed'",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "db:migrate": "wrangler d1 execute pv-erp-db --file=../schema/001_init.sql",
    "db:migrate:local": "wrangler d1 execute pv-erp-db --local --file=../schema/001_init.sql",
    "db:studio": "wrangler d1 studio pv-erp-db",
    "tail": "wrangler tail pv-erp-api",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.5.0",
    "@hono/zod-validator": "^0.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.70.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
